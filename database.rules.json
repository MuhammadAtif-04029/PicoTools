{
  "rules": {
    ".read": false,
    ".write": false,
    "usage": {
      ".read": true,
      "$slug": {
        ".validate": "$slug.matches(/^[a-z0-9-]{1,40}$/)",
        "count": {
          ".write": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)",
          ".validate": "newData.isNumber()"
        },
        "$other": { ".validate": false }
      }
    },
    "feedback": {
      ".read": false,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['tool','message','ts'])",
        "tool": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "message": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 500" },
        "ts": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
